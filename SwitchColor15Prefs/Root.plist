<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
"http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<plist version="1.0">
<dict>

    <key>title</key>
    <string>SwitchColor15</string>

    <key>items</key>
    <array>

        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>SWITCHCOLOR15</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>

            <key>defaults</key>
            <string>com.matias.switchcolor15</string>

            <key>key</key>
            <string>enabled</string>

            <key>default</key>
            <true/>

            <key>label</key>
            <string>Activar SwitchColor15</string>

            <key>PostNotification</key>
            <string>com.matias.switchcolor15/settingschanged</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSMultiValueCell</string>

            <key>defaults</key>
            <string>com.matias.switchcolor15</string>

            <key>key</key>
            <string>preset</string>

            <key>default</key>
            <string>blue</string>

            <key>label</key>
            <string>Color del switch</string>

            <key>validTitles</key>
            <array>
                <string>Azul</string>
                <string>Rojo</string>
                <string>Verde</string>
                <string>Morado</string>
            </array>

            <key>validValues</key>
            <array>
                <string>blue</string>
                <string>red</string>
                <string>green</string>
                <string>purple</string>
            </array>

            <key>PostNotification</key>
            <string>com.matias.switchcolor15/settingschanged</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSButtonCell</string>

            <key>label</key>
            <string>Respring</string>

            <key>action</key>
            <string>respring</string>
        </dict>

    </array>

</dict>
</plist>
